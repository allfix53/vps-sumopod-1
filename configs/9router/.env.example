# 9Router Environment Config
# Copy to .env and fill in values

JWT_SECRET=<generate-with: openssl rand -hex 32>
INITIAL_PASSWORD=change-me
DATA_DIR=/app/data
PORT=20128
NODE_ENV=production
API_KEY_SECRET=<generate-with: openssl rand -hex 16>
MACHINE_ID_SALT=<generate-with: openssl rand -hex 16>
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
# Current VM value. Re-test dashboard login before changing this to true.
AUTH_COOKIE_SECURE=false
BASE_URL=https://9router.havedev.com
