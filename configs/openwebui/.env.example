# Open WebUI Environment Config
# Copy to .env and fill in values

# Connect to 9router as OpenAI-compatible API
OPENAI_API_BASE_URL=https://9router.havedev.com/v1
OPENAI_API_KEY=<copy-from-9router-dashboard>

# Disable Ollama (we only use OpenAI-compatible API)
ENABLE_OLLAMA_API=false

# App settings
WEBUI_NAME="Open WebUI"
WEBUI_URL=https://chat-ai.havedev.com

# GitHub credentials for Git operations
GITHUB_TOKEN=<your-github-personal-access-token>
GITHUB_USERNAME=<your-github-username>
